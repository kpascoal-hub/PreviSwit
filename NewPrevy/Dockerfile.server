# =============================================================================
# Dockerfile — previswit-server
# Base: Python 3.11 slim | FastAPI + WebSockets + API REST ASPM
# Versão: 4.0
# =============================================================================
FROM python:3.11-slim AS base

# Metadados
LABEL maintainer="PreviSwit Team" \
      description="PreviSwit Server — FastAPI AI-ASPM v4" \
      version="4.0"

# Variáveis de ambiente Python para comportamento otimizado em containers
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Instala dependências mínimas do sistema, Git e Trivy
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        wget \
        git \
    && rm -rf /var/lib/apt/lists/*

# Instala Trivy (última versão via script oficial)
RUN curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh \
    | sh -s -- -b /usr/local/bin

# Instala Gitleaks
RUN GITLEAKS_VERSION=$(curl -s https://api.github.com/repos/gitleaks/gitleaks/releases/latest | grep '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/') \
    && wget -qO /tmp/gitleaks.tar.gz "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
    && tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
    && rm /tmp/gitleaks.tar.gz \
    && chmod +x /usr/local/bin/gitleaks

# Instala pipx para ferramentas em Python
RUN apt-get update && apt-get install -y pipx && rm -rf /var/lib/apt/lists/*
ENV PATH="/root/.local/bin:${PATH}"

# Instala Semgrep e Checkov via pipx
RUN pipx install semgrep && pipx install checkov

# ── Dependências Python ──────────────────────────────────────────────────────
# Copia apenas o requirements primeiro para cache de layer
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Código-fonte ─────────────────────────────────────────────────────────────
COPY . .

# Cria diretórios de dados se não existirem
RUN mkdir -p /app/data /app/reports

# Porta padrão da API
EXPOSE 10200

# Health check: verifica se a API responde
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=5 \
    CMD curl -f http://localhost:10200/ || exit 1

# Ponto de entrada: uvicorn em modo production
CMD ["uvicorn", "api.api:app", \
     "--host", "0.0.0.0", \
     "--port", "10200", \
     "--workers", "1", \
     "--log-level", "info"]
